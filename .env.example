# Copy to .env.local and fill in. Never commit real values.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
# Sender for invoice emails, on your Resend-verified domain, e.g. "Ledgerly <invoices@mail.example.co.za>"
EMAIL_FROM=
# "log" prints emails instead of sending (development and tests)
EMAIL_TRANSPORT=
# Shared secret for /api/jobs/* (pg_cron sends it). Copy from Supabase Vault "jobs_secret".
JOBS_SECRET=
# AI helper (Groq free tier). Leave blank and the helper says it is not set up. "mock" is for tests only.
AI_PROVIDER=
AI_API_KEY=
# Groq model names change; set these if the defaults stop working (see console.groq.com/docs/models).
AI_MODEL=
AI_VISION_MODEL=
SENTRY_DSN=
# Apps (More > Apps). Each is optional: leave blank and that app shows as "not switched on".
# ASC's own Xero app (developer.xero.com), redirect URI <site>/api/oauth/xero/callback
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# ASC's own Shopify app (Dev Dashboard), redirect URL <site>/api/oauth/shopify/callback
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Issued by Sage to ASC for the South African Sage Business Cloud Accounting API
SAGE_API_KEY=

# Ledgerly's own PayFast merchant account, for Pro subscriptions (not a business's keys). Leave blank and the
# upgrade button says paying is not switched on. Recurring billing must be enabled on the merchant account and a
# passphrase set. Use sandbox until you want real money.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_MODE=sandbox
